---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead
      title={`About | ${SITE_TITLE}`}
      description="Raj Oracle's technical learning, experiments, and project lessons."
    />
  </head>
  <body>
    <Header />
    <main>
      <h1>About Raj Oracle</h1>
      <p>
        I learn by building, testing, and documenting. This blog is where
        I share technical notes, experiments, and lessons from my projects.
      </p>
      <h2>My learning interests</h2>
      <ul>
        <li>Python, FastAPI, and software engineering</li>
        <li>AI, retrieval augmented generation, and evaluation</li>
        <li>SQL, data engineering, and automation</li>
        <li>Docker, CI/CD, and observability</li>
      </ul>
      <h2>What you can expect</h2>
      <p>
        Practical examples, explanations of problems I encounter,
        and notes on how I verify solutions.
      </p>
      <p>
        <a href="https://github.com/krajoracle">Explore my projects on GitHub</a>
      </p>
    </main>
    <Footer />
  </body>
</html>
