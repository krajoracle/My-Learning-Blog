---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import { SITE_TITLE } from '../../consts';
import { getPublishedPosts } from '../../utils/posts';

const posts = await getPublishedPosts();
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead
      title={`Articles | ${SITE_TITLE}`}
      description="Practical learning notes on Python, AI, data engineering, and DevOps."
    />
  </head>
  <body>
    <Header />
    <main>
      <h1>Articles</h1>
      <p>Notes from learning, building, and solving problems.</p>
      {posts.length === 0 && <p>New articles are on the way.</p>}
      <ul class="posts">
        {posts.map((post) => (
          <li>
            <article>
              <h2><a href={`/blog/${post.id}/`}>{post.data.title}</a></h2>
              <p class="date"><FormattedDate date={post.data.pubDate} /></p>
              <p>{post.data.description}</p>
              {post.data.tags.length > 0 && (
                <ul class="tags" aria-label="Topics">
                  {post.data.tags.map((tag) => <li>{tag}</li>)}
                </ul>
              )}
            </article>
          </li>
        ))}
      </ul>
    </main>
    <Footer />
  </body>
</html>

<style>
  .posts {
    list-style: none;
    padding: 0;
  }
  .posts > li {
    padding: 1.5rem 0;
    border-bottom: 1px solid #dce3eb;
  }
  h2 {
    margin: 0 0 0.5rem;
    font-size: 1.5rem;
  }
  .date {
    color: rgb(var(--gray));
    font-size: 0.9rem;
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    padding: 0;
    list-style: none;
  }
  .tags li {
    background: #eef2ff;
    color: #293878;
    padding: 0.25rem 0.75rem;
    border-radius: 999px;
    font-size: 0.8rem;
  }
</style>
