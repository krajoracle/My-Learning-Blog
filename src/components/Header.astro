---
import HeaderLink from './HeaderLink.astro';
---

<header>
  <nav aria-label="Main navigation">
    <a class="brand" href="/">Raj Oracle</a>
    <div class="links">
      <HeaderLink href="/">Home</HeaderLink>
      <HeaderLink href="/blog">Articles</HeaderLink>
      <HeaderLink href="/topics">Topics</HeaderLink>
      <HeaderLink href="/about">About</HeaderLink>
      <a href="https://github.com/krajoracle">GitHub</a>
    </div>
  </nav>
</header>

<style>
  header {
    padding: 0 1rem;
    background: white;
    box-shadow: 0 2px 8px #0000000d;
  }
  nav {
    max-width: 1100px;
    margin: auto;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
  }
  .brand {
    font-size: 1.2rem;
    font-weight: 700;
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem;
  }
  nav a {
    display: inline-block;
    padding: 1rem 0.5rem;
    text-decoration: none;
    border-bottom: 3px solid transparent;
  }
  nav a.active {
    border-bottom-color: var(--accent);
  }
  nav a:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
</style>
